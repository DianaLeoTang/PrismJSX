{
  "name": "codehue",
  "displayName": "CodeHue",
  "description": "Structure coloring + inline translated comments (no rules mapping) for TS/JS/TSX/JSX.",
  "publisher": "codehue",
  "version": "3.3.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DianaLeoTang/PrismJSX"
  },
  "categories": [
    "Other"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onStartupFinished",
    "onCommand:codehue.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codehue.refresh",
        "title": "CodeHue: Refresh Decorations"
      },
      {
        "command": "codehue.clearCache",
        "title": "CodeHue: Clear Translation Cache"
      }
    ],
    "configuration": {
      "title": "CodeHue",
      "properties": {
        "codehue.regionColor": {
          "type": "string",
          "default": "rgba(76, 175, 80, 0.12)",
          "description": "Background color for // #region ... // #endregion ... blocks"
        },
        "codehue.regionBorder": {
          "type": "string",
          "default": "1px solid rgba(76,175,80,0.45)",
          "description": "CSS-like border for region blocks"
        },
        "codehue.stripeWidth": {
          "type": "string",
          "default": "3px",
          "description": "Width of the left color stripe for functions",
          "enum": [
            "2px",
            "3px",
            "4px",
            "5px"
          ]
        },
        "codehue.enableSemanticComments": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline semantic Chinese comments for functions"
        },
        "codehue.colorScheme": {
          "type": "string",
          "default": "vibrant",
          "description": "Color scheme for function decorations (automatically adapts to light/dark theme)",
          "enum": [
            "vibrant",
            "soft",
            "ocean",
            "sunset",
            "forest",
            "neon"
          ],
          "enumDescriptions": [
            "鲜艳多彩 - 高对比度，区分度极高（默认）",
            "柔和淡雅 - 马卡龙色系，护眼舒适",
            "海洋风格 - 蓝绿色系，清新自然",
            "日落风格 - 暖色调，温暖活力",
            "森林风格 - 绿色系，沉稳专注",
            "霓虹风格 - 荧光色，炫酷科技感"
          ]
        },
        "codehue.enableAITranslation": {
          "type": "boolean",
          "default": true,
          "description": "启用 AI 智能翻译（关闭后将显示原函数名）"
        },
        "codehue.aiApiKey": {
          "type": "string",
          "default": "",
          "description": "AI 模型 API Key（可选，留空使用内置 Key）"
        },
        "codehue.aiModelBaseUrl": {
          "type": "string",
          "default": "http://llm-model-hub-apis.sf-express.com",
          "description": "AI模型的基础URL（高级选项）",
          "enum": [
            "http://llm-model-hub-apis.sf-express.com",
            "http://llm-model-hub-apis.int.sfcloud.local:1080",
            "http://llm-model-hub-proxy.sit.sf-express.com"
          ],
          "enumDescriptions": [
            "办公网访问生产环境（默认80端口）",
            "生产环境（内网）",
            "测试环境"
          ]
        },
        "codehue.aiModelName": {
          "type": "string",
          "default": "aiplat/qwen2.5-72b-instruct",
          "description": "AI模型名称（高级选项，大小写敏感）",
          "enum": [
            "aiplat/qwen2.5-72b-instruct",
            "aiplat/qwen2.5-vl-72b",
            "Qwen3-4B"
          ],
          "enumDescriptions": [
            "Qwen2.5 72B 指令模型（推荐）",
            "Qwen2.5 VL 72B 视觉语言模型",
            "Qwen3 4B 轻量模型"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "release": "standard-version",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "build": "tsc && node scripts/build.js",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "standard-version": "^9.5.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^17.2.3"
  }
}
