{
  "name": "codehue",
  "displayName": "CodeHue",
  "description": "Structure coloring + inline translated comments (no rules mapping) for TS/JS/TSX/JSX.",
  "publisher": "codehue",
  "version": "3.3.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DianaLeoTang/PrismJSX"
  },
  "categories": [
    "Other"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onStartupFinished",
    "onCommand:codehue.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codehue.refresh",
        "title": "CodeHue: Refresh Decorations"
      },
      {
        "command": "codehue.clearCache",
        "title": "CodeHue: Clear Translation Cache"
      }
    ],
    "configuration": {
      "title": "CodeHue",
      "properties": {
        "codehue.regionColor": {
          "type": "string",
          "default": "rgba(76, 175, 80, 0.12)",
          "description": "Background color for // #region ... // #endregion ... blocks"
        },
        "codehue.regionBorder": {
          "type": "string",
          "default": "1px solid rgba(76,175,80,0.45)",
          "description": "CSS-like border for region blocks"
        },
        "codehue.stripeWidth": {
          "type": "string",
          "default": "3px",
          "description": "Width of the left color stripe for functions",
          "enum": [
            "2px",
            "3px",
            "4px",
            "5px"
          ]
        },
        "codehue.enableSemanticComments": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline semantic Chinese comments for functions"
        },
        "codehue.colorScheme": {
          "type": "string",
          "default": "vibrant",
          "description": "Color scheme for function decorations (automatically adapts to light/dark theme)",
          "enum": [
            "vibrant",
            "soft",
            "ocean",
            "sunset",
            "forest",
            "neon"
          ],
          "enumDescriptions": [
            "鲜艳多彩 - 高对比度，区分度极高（默认）",
            "柔和淡雅 - 马卡龙色系，护眼舒适",
            "海洋风格 - 蓝绿色系，清新自然",
            "日落风格 - 暖色调，温暖活力",
            "森林风格 - 绿色系，沉稳专注",
            "霓虹风格 - 荧光色，炫酷科技感"
          ]
        },
        "codehue.deepseekApiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API Key for intelligent function name translation (leave empty to use manual mapping)"
        },
        "codehue.deepseekModel": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "DeepSeek model to use for translation",
          "enum": [
            "deepseek-chat",
            "deepseek-coder"
          ]
        },
        "codehue.translationMode": {
          "type": "string",
          "default": "ai",
          "description": "Translation mode: ai (DeepSeek API) or manual (built-in mapping)",
          "enum": [
            "ai",
            "manual"
          ],
          "enumDescriptions": [
            "使用 DeepSeek AI 智能翻译（需配置 API Key）",
            "使用内置手动映射表"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "release": "standard-version",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "standard-version": "^9.5.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
