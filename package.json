{
  "name": "codehue",
  "displayName": "CodeHue",
  "description": "Structure coloring + inline translated comments (no rules mapping) for TS/JS/TSX/JSX.",
  "publisher": "codehue",
  "version": "3.2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DianaLeoTang/PrismJSX"
  },
  "categories": [
    "Other"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onStartupFinished",
    "onCommand:codehue.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codehue.refresh",
        "title": "CodeHue: Refresh Decorations"
      }
    ],
    "configuration": {
      "title": "CodeHue",
      "properties": {
        "codehue.regionColor": {
          "type": "string",
          "default": "rgba(76, 175, 80, 0.12)",
          "description": "Background color for // #region ... // #endregion ... blocks"
        },
        "codehue.regionBorder": {
          "type": "string",
          "default": "1px solid rgba(76,175,80,0.45)",
          "description": "CSS-like border for region blocks"
        },
        "codehue.stripeWidth": {
          "type": "string",
          "default": "3px",
          "description": "Width of the left color stripe for functions",
          "enum": [
            "2px",
            "3px",
            "4px",
            "5px"
          ]
        },
        "codehue.enableSemanticComments": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline semantic Chinese comments for functions"
        },
        "codehue.colorScheme": {
          "type": "string",
          "default": "vibrant",
          "description": "Color scheme for function decorations (automatically adapts to light/dark theme)",
          "enum": [
            "vibrant",
            "pastel",
            "dark"
          ],
          "enumDescriptions": [
            "Vibrant and colorful (default, auto-adapts to theme)",
            "Soft pastel colors (auto-adapts to theme)",
            "Balanced colors (auto-adapts to theme)"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "release": "standard-version",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "standard-version": "^9.5.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  }
}
