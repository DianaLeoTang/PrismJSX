{
  // CodeHue 配置示例
  // 在调试模式下，这些配置会覆盖默认的颜色方案
  
  // 颜色方案（现在默认使用统一的颜色）
  "codehue.colorScheme": "vibrant",
  
  // Region 区域配置
  "codehue.regionColor": "#A7FFEB",
  
  // 功能开关
  "codehue.enableSemanticComments": true,
  "codehue.enableAITranslation": false,
  
  // AI 配置（示例）
  "codehue.aiApiKey": "",
  "codehue.aiModelBaseUrl": "https://api.example.com/v1",
  "codehue.aiModelName": "gpt-3.5-turbo"
}

