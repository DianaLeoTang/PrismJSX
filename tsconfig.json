{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020", "DOM"
    ],
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "types": ["node", "vscode"],
    "moduleResolution": "node"
  },
  "include": [
    "src"
  ]
}